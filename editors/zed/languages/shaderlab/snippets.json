{
  "Unity Shader Template": {
    "prefix": "shader",
    "body": [
      "Shader \"${1:Custom/NewShader}\"",
      "{",
      "\tProperties",
      "\t{",
      "\t\t_MainTex (\"Texture\", 2D) = \"white\" {}",
      "\t\t_Color (\"Color\", Color) = (1,1,1,1)",
      "\t}",
      "\tSubShader",
      "\t{",
      "\t\tTags { \"RenderType\"=\"Opaque\" \"RenderPipeline\"=\"UniversalPipeline\" }",
      "",
      "\t\tPass",
      "\t\t{",
      "\t\t\tName \"ForwardLit\"",
      "\t\t\tTags { \"LightMode\"=\"UniversalForward\" }",
      "",
      "\t\t\tHLSLPROGRAM",
      "\t\t\t#pragma vertex vert",
      "\t\t\t#pragma fragment frag",
      "\t\t\t#include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl\"",
      "",
      "\t\t\tstruct Attributes",
      "\t\t\t{",
      "\t\t\t\tfloat3 positionOS : POSITION;",
      "\t\t\t\tfloat2 uv         : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tstruct Varyings",
      "\t\t\t{",
      "\t\t\t\tfloat4 positionCS : SV_Position;",
      "\t\t\t\tfloat2 uv         : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tVaryings vert(Attributes input)",
      "\t\t\t{",
      "\t\t\t\tVaryings output = (Varyings)0;",
      "\t\t\t\toutput.positionCS = TransformObjectToHClip(input.positionOS.xyz);",
      "\t\t\t\toutput.uv = input.uv;",
      "\t\t\t\treturn output;",
      "\t\t\t}",
      "",
      "\t\t\tfloat4 frag(Varyings input) : SV_Target",
      "\t\t\t{",
      "\t\t\t\t$0",
      "\t\t\t\treturn float4(1.0, 1.0, 1.0, 1.0);",
      "\t\t\t}",
      "\t\t\tENDHLSL",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Complete Unity URP Shader boilerplate"
  },
  "ShaderLab Pass": {
    "prefix": "pass",
    "body": [
      "Pass",
      "{",
      "\tName \"${1:PassName}\"",
      "\tBlend ${2:SrcAlpha OneMinusSrcAlpha}",
      "\tZWrite ${3:On}",
      "",
      "\tHLSLPROGRAM",
      "\t#pragma vertex vert",
      "\t#pragma fragment frag",
      "\t$0",
      "\tENDHLSL",
      "}"
    ],
    "description": "ShaderLab Pass with HLSL block"
  },
  "Properties Block": {
    "prefix": "props",
    "body": [
      "Properties",
      "{",
      "\t_MainTex (\"Texture\", 2D) = \"white\" {}",
      "\t_BaseColor (\"Base Color\", Color) = (1, 1, 1, 1)",
      "\t_Smoothness (\"Smoothness\", Range(0.0, 1.0)) = 0.5",
      "\t$0",
      "}"
    ],
    "description": "ShaderLab Properties block"
  },
  "UsePass": {
    "prefix": "usepass",
    "body": [
      "UsePass \"${1:Shader/PASSNAME}\""
    ],
    "description": "Inserts named pass from another shader"
  },
  "GrabPass": {
    "prefix": "grabpass",
    "body": [
      "GrabPass { \"${1:_BackgroundTexture}\" }"
    ],
    "description": "Captures screen buffer into texture"
  },
  "Stencil Block": {
    "prefix": "stencil",
    "body": [
      "Stencil",
      "{",
      "\tRef ${1:1}",
      "\tComp ${2:Always}",
      "\tPass ${3:Replace}",
      "}"
    ],
    "description": "ShaderLab Stencil buffer block"
  },
  "ZWrite": {
    "prefix": "zwrite",
    "body": [
      "ZWrite ${1|On,Off|}"
    ],
    "description": "Controls depth buffer write"
  },
  "ZTest": {
    "prefix": "ztest",
    "body": [
      "ZTest ${1|LEqual,Always,Equal,Less,Greater,GEqual,NotEqual,Off|}"
    ],
    "description": "Controls depth testing mode"
  },
  "ZClip": {
    "prefix": "zclip",
    "body": [
      "ZClip ${1|True,False|}"
    ],
    "description": "Controls GPU near/far depth clipping"
  },
  "Cull": {
    "prefix": "cull",
    "body": [
      "Cull ${1|Back,Front,Off|}"
    ],
    "description": "Polygon face culling mode"
  },
  "Blend": {
    "prefix": "blend",
    "body": [
      "Blend ${1|Off,SrcAlpha OneMinusSrcAlpha,One One,One OneMinusSrcAlpha,OneMinusDstColor One,DstColor Zero|}"
    ],
    "description": "Alpha blending mode"
  },
  "BlendOp": {
    "prefix": "blendop",
    "body": [
      "BlendOp ${1|Add,Sub,RevSub,Min,Max|}"
    ],
    "description": "Blend operation"
  },
  "Tags": {
    "prefix": "tags",
    "body": [
      "Tags { \"${1:RenderType}\" = \"${2:Opaque}\" \"${3:RenderPipeline}\" = \"${4:UniversalPipeline}\" }"
    ],
    "description": "ShaderLab SubShader/Pass tags"
  }
}
